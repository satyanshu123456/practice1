PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_collab_db
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Google OAuth (From console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary Setup (From console.cloudinary.com -> Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

